# Nginx Reverse Proxy Configuration Example for https://qaq-tool.fun/qaqchat/

server {
    listen 443 ssl http2;
    server_name qaq-tool.fun;

    # SSL Certificates (e.g. Let's Encrypt)
    # ssl_certificate /etc/letsencrypt/live/qaq-tool.fun/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/qaq-tool.fun/privkey.pem;

    # Route /qaqchat/ to NestJS Backend running on port 3000
    location /qaqchat/ {
        proxy_pass http://127.0.0.1:3000/;
        proxy_http_version 1.1;

        # WebSocket support (Required for real-time Chat & Voice events)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeouts for persistent WebSocket connections
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
